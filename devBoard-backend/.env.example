# Spring Boot reads these from the process environment. Keep your real values in
# an untracked local file or configure them in your terminal/IDE; never commit them.

DB_URL=jdbc:postgresql://localhost:5432/devboard
DB_USER=postgres
DB_PASSWORD=

# Generate a unique value with at least 64 characters for each environment.
JWT_SECRET=

# Base64-encoded 256-bit AES key used to encrypt GitHub tokens at rest.
ENCRYPTION_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
APP_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
